.DS_Store
Thumbs.db

# Angular Environments (Sensitive / Local Configuration)
/src/environments/environment.ts
/src/environments/environment.development.ts

# dont ignore sample env
!/src/environments/environment.sample.ts
!src/app/pages/

# ==========================================
# 1. FRONTEND (ANGULAR) CONFIG
# ==========================================
# Mengabaikan file environment asli
/FE/Transport_Management_System/src/environments/environment.ts
/FE/Transport_Management_System/src/environments/environment.development.ts

# JANGAN mengabaikan file template/sample
!/FE/Transport_Management_System/src/environments/environment.sample.ts

# Mengabaikan dependensi dan hasil build Angular
**/node_modules/
/FE/Transport_Management_System/dist/
/FE/Transport_Management_System/.angular/

# ==========================================
# 2. BACKEND (.NET) CONFIG
# ==========================================
# Mengabaikan file appsettings konfigurasi database asli
/BE/TransportManagementSystem/appsettings.json
/BE/TransportManagementSystem/appsettings.Development.json

# JANGAN mengabaikan file template/sample appsettings
!/BE/TransportManagementSystem/appsettings.Sample.json

# Mengabaikan SELURUH file cache Visual Studio (.vs)
.vs/
**/.vs/
*.suo
*.user

# Mengabaikan hasil kompilasi dan cache .NET
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.user

